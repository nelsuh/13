# Game host: /opt/usion-games/env/13.env (mode 600). Never commit the real values.
# On the Amazon game host (env/13.env) SERVICE_ID / API_URL / NOTIFY_SECRET work too.
USION_SERVICE_ID=
USION_API_URL=https://mobile.mongolai.mn
# Usion service signing secret: lets the server push the reminder while the app is closed.
USION_NOTIFY_SECRET=
# Without it sign-ups live in memory and vanish on every deploy.
MONGODB_URI=
MONGODB_DB=t13
# How long before the start the reminder goes out (default 180000 = 3 min).
REMIND_LEAD_MS=
NODE_ENV=production
